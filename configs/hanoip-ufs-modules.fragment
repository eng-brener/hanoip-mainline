# Apply after the USB-shell fragment. Load these manually over the live shell.
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
CONFIG_SCSI_UFS_QCOM=m
CONFIG_SCSI_UFS_CRYPTO=n
CONFIG_SCSI_UFS_BSG=n
CONFIG_SCSI_UFS_HWMON=n
CONFIG_SCSI_UFSHCD_PCI=n
CONFIG_SCSI_UFS_CDNS_PLATFORM=n
CONFIG_RPMB=n
CONFIG_MAGIC_SYSRQ=y
