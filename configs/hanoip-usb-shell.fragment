# Initial USB bring-up: no internal UFS access.
CONFIG_SCSI_UFSHCD=n
CONFIG_SCSI_UFS_QCOM=n
CONFIG_QCOM_ICE=n
CONFIG_MMC_SDHCI_MSM=n
CONFIG_QCOM_IPA=n
CONFIG_QCOM_WDT=n
CONFIG_DRM_MSM=n
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_REGULATOR_QCOM_LCDB=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
