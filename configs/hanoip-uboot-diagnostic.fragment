CONFIG_DEFAULT_DEVICE_TREE="qcom/sm7150-motorola-hanoip-diagnostic"
CONFIG_ENV_SOURCE_FILE="hanoip-diagnostic"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/hanoip-diagnostic.env"
CONFIG_OF_EMBED=y
CONFIG_OF_SEPARATE=n
CONFIG_BOOTMETH_ANDROID=y
CONFIG_CMD_ABOOTIMG=y
CONFIG_FASTBOOT_FLASH=n
CONFIG_FASTBOOT_OEM_RUN=n
CONFIG_FASTBOOT_UUU_SUPPORT=n
CONFIG_FASTBOOT_OEM_BOARD=n
CONFIG_FASTBOOT_CMD_OEM_FORMAT=n
CONFIG_FASTBOOT_CMD_OEM_PARTCONF=n
CONFIG_FASTBOOT_CMD_OEM_BOOTBUS=n
CONFIG_CMD_USB_MASS_STORAGE=n
CONFIG_CMD_SAVEENV=n
CONFIG_CMD_GPT=n
CONFIG_EFI_RUNTIME_UPDATE_CAPSULE=n
CONFIG_EFI_CAPSULE_ON_DISK=n
CONFIG_EFI_CAPSULE_ON_DISK_EARLY=n
CONFIG_EFI_CAPSULE_FIRMWARE_RAW=n
CONFIG_EFI_VARIABLE_FILE_STORE=n
CONFIG_EFI_VARIABLE_NO_STORE=y
CONFIG_USB_GADGET_MANUFACTURER="Motorola"
CONFIG_USB_GADGET_VENDOR_NUM=0x18d1
CONFIG_USB_GADGET_PRODUCT_NUM=0x4ee0
