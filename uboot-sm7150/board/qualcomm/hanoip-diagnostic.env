# Volatile diagnostic boot only. No bootflow scan, UMS or persistent env.
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
fastboot=fastboot -l $fastboot_addr_r usb 0
preboot=
bootcmd=run fastboot
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1
menucmd=bootmenu -1
bootmenu_0=Enable fastboot (RAM boot only)=run fastboot
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Board info=bdinfo; pause
bootmenu_3=Dump bootargs=fdt print /chosen bootargs; pause
bootmenu_4=Reset device=reset
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
