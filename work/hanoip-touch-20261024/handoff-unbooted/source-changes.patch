diff --git a/kernel-mainline/drivers/gpu/drm/msm/msm_iommu.c b/kernel-mainline/drivers/gpu/drm/msm/msm_iommu.c
index 897e42c8d..66ab90753 100644
--- a/kernel-mainline/drivers/gpu/drm/msm/msm_iommu.c
+++ b/kernel-mainline/drivers/gpu/drm/msm/msm_iommu.c
@@ -7,6 +7,7 @@
 #include <linux/adreno-smmu-priv.h>
 #include <linux/io-pgtable.h>
 #include <linux/kmemleak.h>
+#include <linux/of_address.h>
 #include "msm_drv.h"
 #include "msm_gpu_trace.h"
 #include "msm_mmu.h"
@@ -723,6 +724,34 @@ static const struct msm_mmu_funcs funcs = {
 		.set_stall = msm_iommu_set_stall,
 };
 
+static int msm_iommu_hanoip_firmware_map(struct msm_iommu *iommu, struct device *dev)
+{
+	struct device_node *memory;
+	struct resource region;
+	int ret;
+
+	if (!of_machine_is_compatible("motorola,hanoip") ||
+	    !of_device_is_compatible(dev->of_node, "qcom,sm7150-mdss"))
+		return 0;
+	memory = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!memory)
+		return 0;
+	ret = of_address_to_resource(memory, 0, &region);
+	of_node_put(memory);
+	if (ret)
+		return ret;
+	/* Only the separately reserved, collected hanoip splash range is allowed. */
+	if (region.start != 0x9c000000 || resource_size(&region) != 0x1700000)
+		return -EINVAL;
+	ret = iommu_map(iommu->domain, region.start, region.start,
+			resource_size(&region), IOMMU_READ, GFP_KERNEL);
+	if (ret)
+		return ret;
+	iommu->base.firmware_start = region.start;
+	dev_info(dev, "HANOIP: mapped firmware framebuffer %pr before DMA attach\n", &region);
+	return 0;
+}
+
 struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
 {
 	struct iommu_domain *domain;
@@ -749,6 +778,13 @@ struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
 
 	mutex_init(&iommu->init_lock);
 
+	ret = msm_iommu_hanoip_firmware_map(iommu, dev);
+	if (ret) {
+		iommu_domain_free(domain);
+		kfree(iommu);
+		return ERR_PTR(ret);
+	}
+
 	ret = iommu_attach_device(iommu->domain, dev);
 	if (ret) {
 		iommu_domain_free(domain);
