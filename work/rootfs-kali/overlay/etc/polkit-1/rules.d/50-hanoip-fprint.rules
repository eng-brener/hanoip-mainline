// Cadastrar ou apagar digitais exige a senha do próprio usuário, como o
// Android exige o PIN. (O fprintd usa a ação "enroll" para os dois.)
polkit.addRule(function(action, subject) {
    if (action.id == "net.reactivated.fprint.device.enroll" &&
        subject.user != "root")
        return polkit.Result.AUTH_SELF;
});
