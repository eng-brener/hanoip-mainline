#!/bin/sh
# initramfs-tools hook: pull the hanoip-guard script and blockdev into the initrd.
set -e
PREREQ=""
prereqs() { echo "${PREREQ}"; }
case "$1" in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
copy_exec /usr/sbin/blockdev /sbin
copy_exec /usr/share/initramfs-tools/scripts/init-premount/hanoip-guard /scripts/init-premount
