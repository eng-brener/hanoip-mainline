#!/bin/sh
# hanoip-cpu-tune — aplica no boot os ajustes de CPU que não são persistentes.
#
# O kernel volta ao padrão a cada boot; estes dois ajustes são escolha nossa:
#   1. governor de idle: teo (em vez de menu). O TEO está compilado desde
#      28/10 (CONFIG_CPU_IDLE_GOV_TEO=y) e costuma render melhor residência em
#      ARM moderno.
#   2. governor térmico das zonas de CPU: power_allocator (IPA) em vez de
#      step_wise. IPA distribui o orçamento térmico por todos os cooling
#      devices em vez de ligar/desligar em degraus; melhor em carga longa.
#
# Ambos são reversíveis e verificados por log; se algo não existir (kernel sem
# TEO, zona sem IPA), o script apenas registra e segue.

LOG=/run/hanoip-cpu-tune.log
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

: > "$LOG"

# 1) idle governor
if grep -qw teo /sys/devices/system/cpu/cpuidle/available_governors 2>/dev/null; then
    echo teo > /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null
    log "idle governor: $(cat /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null)"
else
    log "idle governor: teo indisponivel; mantendo $(cat /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null)"
fi

# 2) thermal governor das zonas de CPU
n=0
for z in /sys/class/thermal/thermal_zone*; do
    t=$(cat "$z/type" 2>/dev/null)
    case "$t" in
    cpu*-thermal)
        case "$(cat "$z/policy" 2>/dev/null)" in
        power_allocator) n=$((n+1)) ;;
        *)
            if grep -qw power_allocator "$z/available_policies" 2>/dev/null; then
                echo power_allocator > "$z/policy" 2>/dev/null && n=$((n+1))
            fi
            ;;
        esac
        ;;
    esac
done
log "thermal: power_allocator em $n zonas de CPU (step_wise segue disponivel)"
log "estado: nucleos=$(cat /sys/devices/system/cpu/online) idle=$(cat /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null)"
