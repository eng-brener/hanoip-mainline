	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0x08 0x01 0x02 0x08 0x01 0x03 0x08 0x01 0x00 0x08>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0xe1>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			gpios = <0xa7 0x02 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	regulator-vph-pwr {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0xba>;
	};

	regulator-ibb {
		compatible = "regulator-fixed";
		regulator-name = "ibb";
		regulator-min-microvolt = <0x5b8d80>;
		regulator-max-microvolt = <0x5b8d80>;
	};

	regulator-vddi {
		compatible = "regulator-fixed";
		regulator-name = "vddi";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0xa4>;
	};

	regulator-vdda-dsi {
		compatible = "regulator-fixed";
		regulator-name = "vdda_dsi";
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0xa1>;
	};

	regulator-vdds-dsi-pll {
		compatible = "regulator-fixed";
		regulator-name = "vdds_dsi_pll";
		regulator-min-microvolt = <0xdbba0>;
		regulator-max-microvolt = <0xdbba0>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0xad>;
	};

	regulator-lab {
		compatible = "regulator-fixed";
		regulator-name = "lab";
		regulator-min-microvolt = <0x5d1420>;
		regulator-max-microvolt = <0x5d1420>;
	};

	regulator-smpa3 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s3a_0p8";
		regulator-min-microvolt = "\0\f5";
		regulator-max-microvolt = "\0\f5";
		regulator-always-on;
		vin-supply = <0xba>;
		phandle = <0xbe>;
	};

	battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		voltage-min-design-microvolt = <0x30d400>;
		voltage-max-design-microvolt = <0x43e6d0>;
		charge-full-design-microamp-hours = <0x5e3530>;
		constant-charge-current-max-microamp = <0x36ee80>;
		phandle = <0xb5>;
	};

	audio-codec-dummy {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0x00>;
	};

	sound {
		compatible = "qcom,sm8250-sndcard";
		model = "Motorola Moto G60";
		pinctrl-0 = <0xe2>;
		pinctrl-names = "default";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <0xe3 0x00>;
			};
		};

		speaker-dai-link {
			link-name = "Speaker Playback";

			cpu {
				sound-dai = <0xe4 0x12>;
			};

			platform {
				sound-dai = <0xe5>;
			};

			codec {
				sound-dai = <0xe6>;
			};
		};
	};
};
