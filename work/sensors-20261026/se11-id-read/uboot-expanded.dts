		wifi@18800000 {
			compatible = "qcom,wcn3990-wifi";
			reg = <0x00 0x18800000 0x00 0x800000>;
			reg-names = "membase";
			interrupts = <0x00 0x19e 0x01 0x00 0x19f 0x01 0x00 0x1a0 0x01 0x00 0x1a1 0x01 0x00 0x1a2 0x01 0x00 0x1a3 0x01 0x00 0x1a4 0x01 0x00 0x1a5 0x01 0x00 0x1a6 0x01 0x00 0x1a7 0x01 0x00 0x1a8 0x01 0x00 0x1a9 0x01>;
			iommus = <0x32 0x240 0x01>;
			memory-region = <0xc0>;
			status = "okay";
			vdd-0.8-cx-mx-supply = <0xc1>;
			vdd-1.8-xo-supply = <0x49>;
			vdd-1.3-rfa-supply = <0x4a>;
			vdd-3.3-ch0-supply = <0x4b>;
