		pinctrl@62b52000 {
			compatible = "qcom,sm7150-lpass-lpi-pinctrl";
			reg = <0x00 0x62b52000 0x00 0xe000>;
			clocks = <0xc3 0x66 0x01>;
			clock-names = "core";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0xc4 0x00 0x00 0x0e>;
			phandle = <0xc4>;

			tx-swr-active-state {

				clk-pins {
					pins = "gpio0";
					function = "swr_tx_clk";
					drive-strength = <0x08>;
					bias-bus-hold;
				};

				data1-pins {
					pins = "gpio1";
					function = "swr_tx_data";
					drive-strength = <0x08>;
					bias-bus-hold;
				};

				data2-pins {
					pins = "gpio2";
					function = "swr_tx_data";
					drive-strength = <0x08>;
					bias-bus-hold;
				};
			};

			tx-swr-sleep-state {

				clk-pins {
					pins = "gpio0";
					function = "swr_tx_clk";
					drive-strength = <0x02>;
					bias-bus-hold;
				};

				data1-pins {
					pins = "gpio1";
					function = "swr_tx_data";
					drive-strength = <0x02>;
					bias-bus-hold;
				};

				data2-pins {
					pins = "gpio2";
					function = "swr_tx_data";
					drive-strength = <0x02>;
					bias-bus-hold;
				};
			};

			rx-swr-active-state {

				clk-pins {
					pins = "gpio3";
					function = "swr_rx_clk";
					drive-strength = <0x08>;
					bias-bus-hold;
				};

				data-pins {
					pins = "gpio4\0gpio5";
					function = "swr_rx_data";
					drive-strength = <0x08>;
					bias-bus-hold;
				};
			};

			rx-swr-sleep-state {

				clk-pins {
					pins = "gpio3";
					function = "swr_rx_clk";
					drive-strength = <0x02>;
					bias-bus-hold;
				};

				data-pins {
					pins = "gpio4\0gpio5";
					function = "swr_rx_data";
					drive-strength = <0x02>;
					bias-bus-hold;
				};
			};

			wcd9375-reset-active-state {
				pins = "gpio6";
				function = "cdc_pdm_rx";
				drive-strength = <0x10>;
				output-high;
			};

			wcd9375-reset-sleep-state {
				pins = "gpio6";
				function = "cdc_pdm_rx";
				drive-strength = <0x10>;
				bias-disable;
				output-low;
			};

			dmic01-active-state {

				clk-pins {
					pins = "gpio8";
					function = "dmic1_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio9";
					function = "dmic1_data";
					drive-strength = <0x08>;
					input-enable;
				};
			};

			dmic01-sleep-state {

				clk-pins {
					pins = "gpio8";
					function = "dmic1_clk";
					drive-strength = <0x02>;
					bias-disable;
				};

				data-pins {
					pins = "gpio9";
					function = "dmic1_data";
					drive-strength = <0x02>;
					pull-down;
					input-enable;
				};
			};

			dmic23-active-state {

				clk-pins {
					pins = "gpio10";
					function = "dmic2_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio11";
					function = "dmic2_data";
					drive-strength = <0x08>;
					input-enable;
				};
			};

			dmic23-sleep-state {

				clk-pins {
					pins = "gpio10";
					function = "dmic2_clk";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};

				data-pins {
					pins = "gpio11";
					function = "dmic2_data";
					drive-strength = <0x02>;
					pull-down;
					input-enable;
				};
			};
		};

		pinctrl@62b48000 {
