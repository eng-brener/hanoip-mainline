#!/bin/sh
# Mount only RAM-backed and pseudo filesystems, never phone partitions.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/ HISTFILE=/dev/null TERM=vt100
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /run /tmp /sys/kernel/config /dev/pts
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t configfs configfs /sys/kernel/config
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
echo 'HANOIP: USB shell + network initramfs; no disk partitions mounted'

udc=''
while [ -z "$udc" ]; do
    for device in /sys/class/udc/*; do
        [ -e "$device" ] || continue
        udc=${device##*/}
        break
    done
    [ -n "$udc" ] || sleep 1
done

# One configuration with ACM (serial console) and NCM (network); see
# Documentation/usb/gadget_configfs.rst. If NCM cannot bind, fall back to ACM.
G=/sys/kernel/config/usb_gadget/g1
if (
    set -e
    mkdir -p "$G/strings/0x409"
    echo 0x1d6b > "$G/idVendor"
    echo 0x0104 > "$G/idProduct"
    echo 0x0100 > "$G/bcdDevice"
    echo 0x0200 > "$G/bcdUSB"
    echo 0xEF > "$G/bDeviceClass"
    echo 0x02 > "$G/bDeviceSubClass"
    echo 0x01 > "$G/bDeviceProtocol"
    echo hanoip-diagnostic > "$G/strings/0x409/serialnumber"
    echo Motorola > "$G/strings/0x409/manufacturer"
    echo 'Hanoip USB shell + network (RAM only)' > "$G/strings/0x409/product"
    mkdir -p "$G/functions/acm.usb0" "$G/configs/c.1/strings/0x409"
    echo 'CDC ACM shell + CDC NCM network' > "$G/configs/c.1/strings/0x409/configuration"
    echo 500 > "$G/configs/c.1/MaxPower"
    ln -s "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"
); then
    if (
        set -e
        mkdir -p "$G/functions/ncm.usb0"
        echo 02:68:61:6e:6f:01 > "$G/functions/ncm.usb0/dev_addr"
        echo 02:68:61:6e:6f:02 > "$G/functions/ncm.usb0/host_addr"
        ln -s "$G/functions/ncm.usb0" "$G/configs/c.1/ncm.usb0"
    ); then
        echo 'HANOIP: NCM function linked'
    else
        echo 'HANOIP: NCM setup failed; ACM only'
    fi
    if echo "$udc" > "$G/UDC"; then
        echo "HANOIP: gadget bound to $udc"
    else
        echo 'HANOIP: bind failed; retrying with ACM only'
        rm -f "$G/configs/c.1/ncm.usb0"
        echo "$udc" > "$G/UDC" && echo "HANOIP: ACM bound to $udc"
    fi
else
    echo 'HANOIP: USB gadget setup failed; see kernel console'
fi

[ ! -e "$G/configs/c.1/ncm.usb0" ] || /sbin/start-usbnet &

while :; do
    if [ -c /dev/ttyGS0 ]; then
        # Open the TTY after setsid to give the shell a controlling terminal.
        /bin/busybox setsid /bin/busybox sh -c '
            exec </dev/ttyGS0 >/dev/ttyGS0 2>&1
            echo
            echo "HANOIP USB SHELL; filesystems in RAM; no partitions mounted"
            /bin/busybox uname -a
            exec /bin/busybox sh -i
        '
    fi
    sleep 1
done
