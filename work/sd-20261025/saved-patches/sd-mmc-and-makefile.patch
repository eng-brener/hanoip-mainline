diff --git a/kernel-mainline/drivers/mmc/core/regulator.c b/kernel-mainline/drivers/mmc/core/regulator.c
index a85179f1a..0aab14f81 100644
--- a/kernel-mainline/drivers/mmc/core/regulator.c
+++ b/kernel-mainline/drivers/mmc/core/regulator.c
@@ -219,8 +219,26 @@ int mmc_regulator_set_vqmmc(struct mmc_host *mmc, struct mmc_ios *ios)
 		if (ret >= 0)
 			return ret;
 
-		return mmc_regulator_set_voltage_if_supported(mmc->supply.vqmmc,
+		ret = mmc_regulator_set_voltage_if_supported(mmc->supply.vqmmc,
 						2700000, volt, 3600000);
+		if (ret >= 0)
+			return ret;
+
+		/*
+		 * Some vqmmc regulators top out below 3.3 V (for example at
+		 * 2.95 V).  SD allows 2.7-3.6 V, so use the highest supported
+		 * level in that window instead of failing the power-up.
+		 */
+		if (regulator_is_supported_voltage(mmc->supply.vqmmc,
+						   2950000, 2950000))
+			return regulator_set_voltage(mmc->supply.vqmmc,
+						     2950000, 2950000);
+		if (regulator_is_supported_voltage(mmc->supply.vqmmc,
+						   2700000, 2700000))
+			return regulator_set_voltage(mmc->supply.vqmmc,
+						     2700000, 2700000);
+
+		return ret;
 	default:
 		return -EINVAL;
 	}
