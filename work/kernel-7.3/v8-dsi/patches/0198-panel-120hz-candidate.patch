@@ -27,6 +27,7 @@
 
 struct panel_desc {
 	const struct drm_display_mode *mode;
+	const struct drm_display_mode *experimental_mode;
 	unsigned int lanes;
 	enum mipi_dsi_pixel_format format;
 	unsigned long mode_flags;
@@ -209,8 +210,20 @@
 static int ili7807s_get_modes(struct drm_panel *panel, struct drm_connector *connector)
 {
 	struct ili7807s *ctx = to_ili7807s(panel);
+	struct drm_display_mode *mode;
+	int count;
 
-	return drm_connector_helper_get_modes_fixed(connector, ctx->desc->mode);
+	count = drm_connector_helper_get_modes_fixed(connector, ctx->desc->mode);
+	if (count < 0 || !ctx->desc->experimental_mode)
+		return count;
+
+	mode = drm_mode_duplicate(connector->dev, ctx->desc->experimental_mode);
+	if (!mode)
+		return count;
+
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	return count + 1;
 }
 
