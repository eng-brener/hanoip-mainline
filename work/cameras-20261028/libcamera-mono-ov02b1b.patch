+void SwStatsCpu::statsMono10PLine0(const uint8_t *src[], SwIspStats &stats)
+{
+	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
+	const uint8_t *src1 = src[2] + window_.x * 5 / 4;
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+	uint64_t sum = 0;
+
+	for (unsigned int x = 0; x < widthInBytes; x += 5) {
+		unsigned int y = (src0[x] + src0[x + 1] +
+				  src1[x] + src1[x + 1]) / 4;
+		sum += y;
+		stats.yHistogram[y * SwIspStats::kYHistogramSize / 256]++;
+	}
+	stats.sum_.r() += sum;
+	stats.sum_.g() += sum;
+	stats.sum_.b() += sum;
+}
