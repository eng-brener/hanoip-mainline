+template<bool addAlphaByte>
+void DebayerCpu::mono10P_BGR888(uint8_t *dst, const uint8_t *src[])
+{
+	const uint8_t *curr = src[1];
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+
+	for (unsigned int x = 0; x < widthInBytes; x += 5) {
+		for (unsigned int k = 0; k < 4; k++) {
+			uint8_t value = green_[curr[x + k]];
+			*dst++ = value;
+			*dst++ = value;
+			*dst++ = value;
+			if constexpr (addAlphaByte)
+				*dst++ = 255;
+		}
+	}
+}
